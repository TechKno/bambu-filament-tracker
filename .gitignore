# ---- Python ----
__pycache__/
*.pyc
.venv/
web/.venv/

# ---- Node / frontend build ----
node_modules/
web/frontend/dist/

# ---- Live data & backups (on the server, not in source) ----
web/data/*
!web/data/.gitkeep

# ---- Secrets (never commit) ----
**/settings.json
*.env
.env
web/secrets/
printers.json

# ---- Build artifacts ----
*.tar.gz

# ---- OS / editor cruft ----
Thumbs.db
.DS_Store
.vscode/
.idea/
